<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDEDED"
    tools:context=".ui.daftartugas.DaftarTugasFragment">

    <!-- ======== NAV HEADER (TAB PILIHAN) ======== -->
    <LinearLayout
        android:id="@+id/navHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:paddingVertical="8dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tabSelesai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELESAI"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:textColor="#6200EE"
            android:background="@drawable/tab_selected_bg" />

        <TextView
            android:id="@+id/tabProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IN PROGRESS"
            android:textSize="16sp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:textColor="#666666" />
    </LinearLayout>

    <!-- ======== DAFTAR TUGAS ======== -->
    <ScrollView
        android:id="@+id/scrollTugas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/navHeader"
        android:layout_marginTop="8dp"
        android:padding="12dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Contoh Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/card_task_bg"
                android:padding="10dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_circle_green"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bersihkan Kamar"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jumat 23-09-2025, 23:30 • Pribadi"
                        android:textColor="#64B5F6"
                        android:textSize="12sp" />
                </LinearLayout>

                <CheckBox
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#666666" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ======== FLOATING ACTION BUTTON ======== -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="24dp"
        android:src="@drawable/ic_delete_red"
        android:backgroundTint="#F44336"
        android:contentDescription="Delete task" />

</RelativeLayout>