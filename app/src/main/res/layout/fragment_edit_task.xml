<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    android:background="#F5F5F5"
    tools:context=".ui.editTask.EditTaskFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Judul Halaman -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Tugas"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:layout_marginBottom="16dp" />

        <!-- Input Judul -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Judul Tugas"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/input_judul"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Masukkan judul tugas"
            android:background="#E0E0E0"
            android:paddingHorizontal="12dp"
            android:textColor="@android:color/black"
            android:backgroundTint="@null"
            android:layout_marginBottom="12dp" />

        <!-- Input Deskripsi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deskripsi"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/input_deskripsi"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Tulis deskripsi tugas di sini"
            android:gravity="top|start"
            android:background="#E0E0E0"
            android:padding="12dp"
            android:backgroundTint="@null"
            android:textColor="@android:color/black"
            android:layout_marginBottom="12dp" />

        <!-- Input Tanggal -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jatuh Tempo"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="#E0E0E0"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tv_tanggal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pilih tanggal"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <ImageView
                android:id="@+id/btn_pilih_tanggal"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_today"
                app:tint="@android:color/black" />
        </LinearLayout>

        <!-- Upload Gambar -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lampiran Gambar"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="4dp" />

        <ImageView
            android:id="@+id/preview_gambar"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:background="#E0E0E0"
            android:layout_marginBottom="8dp"
            android:contentDescription="Preview gambar" />

        <Button
            android:id="@+id/btn_upload_gambar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ubah Gambar"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:backgroundTint="#DDDDDD"
            android:layout_marginBottom="20dp" />

        <!-- Tombol Update dan Batal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btn_batal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Batal"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:backgroundTint="#FFCCCB"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_update_tugas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Update Tugas"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:backgroundTint="#4CAF50"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>