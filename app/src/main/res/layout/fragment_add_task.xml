<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="?attr/colorSurface"
    tools:context=".ui.addtask.AddTaskFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Judul Halaman -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tambah Tugas Baru"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="16dp" />

        <!-- Input Judul -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Judul Tugas"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/input_judul"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Masukkan judul tugas"
            android:paddingHorizontal="12dp"
            android:textColor="?attr/colorOnSurface"
            android:backgroundTint="@null"
            android:layout_marginBottom="12dp" />

        <!-- Input Deskripsi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deskripsi"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/input_deskripsi"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Tulis deskripsi tugas di sini"
            android:gravity="top|start"
            android:padding="12dp"
            android:backgroundTint="@null"
            android:textColor="?attr/colorOnSurface"
            android:background="?attr/colorSurfaceVariant"
            android:layout_marginBottom="12dp" />

        <!-- Input Tanggal -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jatuh Tempo"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="?attr/colorSurfaceVariant"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tv_tanggal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="23/09/2025"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <ImageView
                android:id="@+id/btn_pilih_tanggal"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_today"
                android:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Upload Gambar -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lampiran Gambar"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="4dp" />

        <ImageView
            android:id="@+id/preview_gambar"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:background="?attr/colorSurfaceVariant"
            android:layout_marginBottom="8dp"
            android:contentDescription="Preview gambar" />

        <Button
            android:id="@+id/btn_upload_gambar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Gambar"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:backgroundTint="#DDDDDD"
            android:layout_marginBottom="20dp" />

        <!-- Tombol Tambah -->
        <Button
            android:id="@+id/btn_tambah_tugas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tambah Tugas"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#00FF00"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>